# ==============================================================================
# MediVoice AI - Backend Environment Configuration
# Fictional Hospital: Aarogya One Hospital
# ==============================================================================

# Application
PROJECT_NAME="MediVoice AI - Aarogya One Hospital"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# For local development with PostgreSQL:
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/aarogya_one_db"

# Optional: Test Database URL (falls back to in-memory SQLite if PostgreSQL is not running)
# TEST_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/aarogya_one_test"
TEST_DATABASE_URL="sqlite:///./test_aarogya.db"

# Hospital Identifier
DEFAULT_HOSPITAL_ID="11111111-1111-1111-1111-111111111111"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]
