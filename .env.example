API_V1_STR=/api/v1
# CORS origins: supports comma-separated list or JSON array string
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:3001","http://127.0.0.1:5173"]
# Database connection: SQLite for local development, postgresql+psycopg2:// in production
DATABASE_URL=sqlite:///./medivoice.db
DEBUG=true
DEFAULT_HOSPITAL_ID=11111111-1111-1111-1111-111111111111
ENVIRONMENT=development
PROJECT_NAME=MediVoice AI - Aarogya One Hospital

# Staff RBAC Security & Demo Auth
MEDIVOICE_AUTH_SECRET=local-demo-only-change-before-deployment
ENABLE_DEMO_STAFF_AUTH=false

# Frontend API Endpoint (Vercel deployment)
VITE_API_BASE_URL=

# AI Reasoning Provider Configuration ("gemini" or "mock")
AI_PROVIDER=gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=35.0
GEMINI_MAX_TOOL_ROUNDS=4
GEMINI_ENABLE_FALLBACK=false

# Gnani Voice AI Platform Configuration (Prisma STT & Timbre TTS)
GNANI_API_KEY=
GNANI_API_BASE=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_DEFAULT_LANGUAGE=en-IN

# Voice Interaction Orchestration
VOICE_ENABLED=true
VOICE_MAX_DURATION_SECONDS=60
VOICE_REQUEST_TIMEOUT_SECONDS=20.0
VOICE_DIAGNOSTICS_ENABLED=false
