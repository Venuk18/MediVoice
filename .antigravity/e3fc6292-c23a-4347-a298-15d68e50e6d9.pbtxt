        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "MediVoice AI is designed as an enterprise, voice-first hospital operations platform. Phase 1 establishes the rock-solid transactional and relational database foundation, ensuring that future reasoning models and speech pipelines interact solely with strictly-typed, validated tool functions and never execute raw SQL or mutate database state directly."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
