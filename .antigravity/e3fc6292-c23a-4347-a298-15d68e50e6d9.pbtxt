          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "def get_appointments("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    db: Session,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    doctor_id: Optional[str] = None,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    patient_reference: Optional[str] = None,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    appointment_status: Optional[str] = None,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    date_filter: Optional[datetime] = None,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ") -> List[Appointment]:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    query = ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        select(Appointment)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        .options("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            joinedload(Appointment.doctor),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            joinedload(Appointment.slot),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if doctor_id:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        query = query.where(Appointment.doctor_id == doctor_id)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if patient_reference:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        query = query.where(Appointment.patient_reference == patient_reference)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if appointment_status:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        query = query.where(Appointment.appointment_status == appointment_status)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    query = query.order_by(Appointment.created_at.desc())"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    results = list(db.scalars(query).all())"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if date_filter:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        target_date_str = date_filter.strftime(\"%Y-%m-%d\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        results = ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            a for a in results"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            if a.slot and a.slot.start_time.strftime(\"%Y-%m-%d\") == target_date_str"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return results"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "def book_appointment("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    db: Session,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    patient_reference: str,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    doctor_id: str,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    slot_id: str,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    reason_category: str,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    actor_reference: str = \"PATIENT_PORTAL\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ") -> Appointment:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"\"\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    Transaction-safe appointment booking with multi-tier validation:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    1. Doctor existence & active status validation."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    2. Slot existence & doctor ownership verification."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    3. Availability check & future slot validation."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    4. Concurrency lock (FOR UPDATE where supported) & atomic status update to BOOKED."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    5. Database unique constraint enforcement on slot_id to prevent double bookings."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    6. Audit event generation inside the same commit unit."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"\"\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    # Normalize current time"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    now_utc = datetime.now(timezone.utc)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    try:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Validate doctor"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        doctor = db.scalars(select(Doctor).where(Doctor.id == doctor_id)).first()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if not doctor:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            raise HTTPException("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                status_code=status.HTTP_404_NOT_FOUND,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                detail=f\"Doctor with ID \'{doctor_id}\' does not exist.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if not doctor.is_active:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            raise HTTPException("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                status_code=status.HTTP_400_BAD_REQUEST,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                detail=f\"Doctor \'{doctor.display_name}\' is currently inactive.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Slot query with row-locking when dialect supports FOR UPDATE (e.g., PostgreSQL)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        is_sqlite = db.bind is not None and db.bind.dialect.name == \"sqlite\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        slot_query = select(AppointmentSlot).where(AppointmentSlot.id == slot_id)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if not is_sqlite:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            slot_query = slot_query.with_for_update()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        slot = db.scalars(slot_query).first()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if not slot:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            raise HTTPException("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                status_code=status.HTTP_404_NOT_FOUND,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                detail=f\"Appointment slot with ID \'{slot_id}\' not found.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Validate doctor-slot ownership"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if slot.doctor_id != doctor_id:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            raise HTTPException("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                status_code=status.HTTP_400_BAD_REQUEST,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                detail=\"Slot does not belong to the selected doctor.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Validate slot availability"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if slot.status != \"AVAILABLE\":"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            raise HTTPException("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                status_code=status.HTTP_409_CONFLICT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                detail=f\"Slot is no longer available (current status: \'{slot.status}\').\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Validate slot is not in the past"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        slot_start = slot.start_time"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if slot_start.tzinfo is None:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            # Handle naive datetime as UTC for comparison"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            slot_start = slot_start.replace(tzinfo=timezone.utc)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if slot_start < now_utc:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            raise HTTPException("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                status_code=status.HTTP_400_BAD_REQUEST,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                detail=\"Cannot book an appointment slot in the past.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Check if slot already has an active appointment"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        existing_appt = db.scalars("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            select(Appointment).where("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                Appointment.slot_id == slot_id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                Appointment.appointment_status.in_([\"CONFIRMED\", \"COMPLETED\"]),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ).first()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if existing_appt:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            raise HTTPException("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                status_code=status.HTTP_409_CONFLICT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                detail=\"Slot is already reserved by another appointment.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Transition slot status atomically"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        slot.status = \"BOOKED\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Create new appointment with server-enforced initial status"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        appointment = Appointment("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            patient_reference=patient_reference.strip(),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            doctor_id=doctor_id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            slot_id=slot_id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            appointment_status=\"CONFIRMED\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            reason_category=reason_category.strip(),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            follow_up_recommended=False,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        db.add(appointment)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        db.flush()  # Flush to generate appointment.id and verify unique constraints"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Create audit event inside the same transaction"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        audit_details = json.dumps({"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            \"patient_reference\": appointment.patient_reference,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            \"doctor_id\": doctor_id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            \"doctor_name\": doctor.display_name,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            \"slot_id\": slot_id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            \"slot_start\": slot.start_time.isoformat(),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            \"reason_category\": appointment.reason_category,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        })"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        audit = AuditEvent("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            actor_reference=actor_reference,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            action=\"APPOINTMENT_BOOKED\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            entity_type=\"Appointment\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            entity_id=appointment.id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            details=audit_details,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        db.add(audit)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Commit transaction atomically"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        db.commit()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        db.refresh(appointment)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        return appointment"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    except HTTPException:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        db.rollback()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        raise"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    except IntegrityError as exc:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        db.rollback()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        raise HTTPException("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            status_code=status.HTTP_409_CONFLICT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            detail=\"Conflict: Slot has already been reserved concurrently by another transaction.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ) from exc"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    except Exception as exc:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        db.rollback()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        raise HTTPException("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            detail=f\"An unexpected error occurred during appointment booking: {str(exc)}\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ) from exc"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "def cancel_appointment("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    db: Session,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    appointment_id: str,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    cancellation_reason: Optional[str] = None,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    actor_reference: str = \"PATIENT_PORTAL\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ") -> Appointment:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"\"\"Cancels an appointment and re-releases the slot to AVAILABLE.\"\"\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    appointment = get_appointment_by_id(db, appointment_id)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if not appointment:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        raise HTTPException("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            status_code=status.HTTP_404_NOT_FOUND,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            detail=f\"Appointment \'{appointment_id}\' not found.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if appointment.appointment_status == \"CANCELLED\":"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        raise HTTPException("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            status_code=status.HTTP_400_BAD_REQUEST,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            detail=\"Appointment is already cancelled.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if appointment.appointment_status == \"COMPLETED\":"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        raise HTTPException("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            status_code=status.HTTP_400_BAD_REQUEST,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            detail=\"Cannot cancel an appointment that has already been marked completed.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
