          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            print(f\"  [+] Added Doctor: {doc_def[\'name\']} ({doc_def[\'specialty\']})\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        doc_map[doc_def[\"name\"]] = existing_doc"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    # 4. Future Appointment Slots (Multiple future slots per doctor over next 3 days)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    now_utc = datetime.now(timezone.utc).replace(minute=0, second=0, microsecond=0)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    slot_count = 0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    slot_map = {}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    for doc_def in doctor_defs:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        doc_id = doc_def[\"id\"]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Generate 6 future slots for each doctor (days 1, 2, 3: morning 10am, afternoon 2pm)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        for day_offset in [1, 2, 3]:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            for hour in [10, 14]:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                slot_start = (now_utc + timedelta(days=day_offset)).replace(hour=hour)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                slot_end = slot_start + timedelta(minutes=30)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                slot_key = f\"{doc_id}_{slot_start.strftime(\'%Y%m%d%H%M\')}\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                existing_slot = db.scalars("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    select(AppointmentSlot).where("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        AppointmentSlot.doctor_id == doc_id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        AppointmentSlot.start_time == slot_start,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                ).first()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                if not existing_slot:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    existing_slot = AppointmentSlot("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        doctor_id=doc_id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        start_time=slot_start,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        end_time=slot_end,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        status=\"AVAILABLE\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    db.add(existing_slot)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    db.flush()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    slot_count += 1"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                slot_map[slot_key] = existing_slot"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    print(f\"  [+] Configured future appointment slots ({slot_count} new slots generated)\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
